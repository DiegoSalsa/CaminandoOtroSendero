{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "caminando-otro-sendero.vercel.app"
        }
      ],
      "destination": "https://www.caminandootrosendero.cl/:path*",
      "permanent": true
    },
    {
      "source": "/pages/blog",
      "destination": "/pages/publicaciones",
      "permanent": true
    }
  ]
}
